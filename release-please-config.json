{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "harness",
      "components": [
        "harness",
        "originlang-ext-harness",
        "originlang-ext-harness-plugin"
      ],
      "merge": false
    },
    {
      "type": "cargo-workspace",
      "merge": false
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "harness",
      "version-file": "version.txt"
    },
    "crates/harness": {
      "release-type": "rust",
      "component": "originlang-ext-harness",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/plugin": {
      "release-type": "rust",
      "component": "originlang-ext-harness-plugin",
      "skip-github-release": true,
      "skip-changelog": true
    }
  }
}
